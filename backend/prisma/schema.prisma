generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum CashAccountType {
  USD_CASH
  UZS_CASH
  BANK
}

enum TransactionDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELLED
}

enum Language {
  uz
  ru
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

enum ProductType {
  PRODUCT
  RAW_MATERIAL
  SERVICE
  BUNDLE
}

enum UnitOfMeasure {
  piece
  kg
  liter
  meter
  box
  pack
}

enum InventoryDocType {
  INBOUND
  OUTBOUND
  STOCKTAKING
  TRANSFER
}

enum InventoryDocStatus {
  DRAFT
  POSTED
  CANCELLED
  IN_TRANSIT
  RECEIVED
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SalesOrderStatus {
  NEW
  PENDING_APPROVAL
  APPROVED
  SENT_TO_PRODUCTION
  IN_PRODUCTION
  PARTIALLY_READY
  READY
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  READY_TO_SHIP
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentCondition {
  PREPAID_100
  PARTIAL
  CREDIT
}

enum ProductionOrderStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CLICK
  PAYME
}

enum DealStageSlug {
  LEAD
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum PurchaseDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PurchaseReturnStatus {
  NONE
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum ExpenseType {
  TRANSPORT
  CUSTOMS
  BROKER
  INSURANCE
  OTHER
}

enum ExpenseAllocationMethod {
  BY_AMOUNT
  BY_QUANTITY
  BY_WEIGHT
}

enum SalesDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SalesReturnStatus {
  NONE
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum SalesReturnDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum ReturnDocStatus {
  DRAFT
  UNDER_REVIEW
  POSTED
  CANCELLED
}

// ============================================
// CORE TENANT MODEL
// ============================================

model Company {
  id                 String        @id @default(uuid())
  /// Bilingual company name: { "uz": "...", "ru": "..." }
  name               Json
  slug               String        @unique
  defaultLanguage    Language       @default(uz) @map("default_language")
  status             CompanyStatus  @default(TRIAL)
  trialEndsAt        DateTime?      @map("trial_ends_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // Relations
  users              User[]
  roles              Role[]
  branches           Branch[]
  warehouses         Warehouse[]
  taxRates           TaxRate[]
  auditLogs          AuditLog[]
  categories         Category[]
  products           Product[]
  stockLevels        StockLevel[]
  inventoryDocs      InventoryDocument[]
  stockTransfers     StockTransfer[]
  counterparties     Counterparty[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  purchaseOrders     PurchaseOrder[]
  deals              Deal[]
  payments           Payment[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
  supportTickets       SupportTicket[]
  cashAccounts         CashAccount[]
  transactionTypes     TransactionType[]
  financeTransactions  FinanceTransaction[]
  purchaseReceipts     PurchaseReceipt[]
  purchaseExpenses     PurchaseExpense[]
  purchaseReturns      PurchaseReturn[]
  productBatches       ProductBatch[]
  counterpartyFolders  CounterpartyFolder[]
  salesReturns         SalesReturn[]
  priceLists           PriceList[]
  additionalExpenses   AdditionalExpense[]
  batchConsumptions    BatchConsumption[]
  productionOrders     ProductionOrder[]
  stockReservations    StockReservation[]

  @@map("companies")
}

// ============================================
// MODULE 8: SUPER-ADMIN, ANNOUNCEMENTS, TICKETS
// ============================================

model SystemAnnouncement {
  id        String   @id @default(uuid())
  title     Json     // { "uz": "...", "ru": "..." }
  message   Json     // { "uz": "...", "ru": "..." }
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_announcements")
}

model SupportTicket {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  userId      String?        @map("user_id")
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  company  Company         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([tenantId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String        @map("ticket_id")
  senderName String        @map("sender_name")
  isFromAdmin Boolean      @default(false) @map("is_from_admin")
  message    String
  createdAt  DateTime      @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

// ============================================
// MODULE 7: BILLING & SUBSCRIPTION
// ============================================

model Subscription {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  plan           SubscriptionPlan   @default(STARTER)
  status         SubscriptionStatus @default(TRIAL)
  amount         Decimal            @default(0) @db.Decimal(15, 2)
  currency       String             @default("UZS")
  startDate      DateTime           @default(now()) @map("start_date")
  endDate        DateTime           @map("end_date")
  nextBillingAt  DateTime           @map("next_billing_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  company  Company               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([tenantId])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  subscriptionId String?            @map("subscription_id")
  paymentNumber  String             @map("payment_number")
  method         PaymentMethod      @default(CLICK)
  amount         Decimal            @db.Decimal(15, 2)
  status         InvoiceStatus      @default(PAID)
  paidAt         DateTime           @default(now()) @map("paid_at")
  transactionId  String?            @map("transaction_id")
  receiptUrl     String?            @map("receipt_url")
  createdAt      DateTime           @default(now()) @map("created_at")

  company      Company       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, paymentNumber])
  @@index([tenantId])
  @@map("subscription_payments")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  email              String
  passwordHash       String    @map("password_hash")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  preferredLanguage  Language  @default(uz) @map("preferred_language")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  company            Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  createdInventoryDocs InventoryDocument[]
  createdTransfers   StockTransfer[]
  assignedDeals      Deal[]
  supportTickets     SupportTicket[]
  createdPurchaseReceipts PurchaseReceipt[] @relation("CreatedPurchaseReceipts")
  postedPurchaseReceipts  PurchaseReceipt[] @relation("PostedPurchaseReceipts")
  createdPurchaseReturns  PurchaseReturn[]  @relation("CreatedPurchaseReturns")
  createdSalesInvoices SalesInvoice[] @relation("CreatedSalesInvoices")
  postedSalesInvoices  SalesInvoice[] @relation("PostedSalesInvoices")
  createdSalesReturns  SalesReturn[]  @relation("CreatedSalesReturns")
  createdAdditionalExpenses AdditionalExpense[] @relation("CreatedAdditionalExpenses")
  postedAdditionalExpenses  AdditionalExpense[] @relation("PostedAdditionalExpenses")
  assignedSalesOrders       SalesOrder[]        @relation("AssignedSalesOrders")
  createdSalesOrders        SalesOrder[]        @relation("CreatedSalesOrders")
  assignedProductionOrders  ProductionOrder[]   @relation("AssignedProductionOrders")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ============================================
// RBAC — Roles & Permissions
// ============================================

model Role {
  id            String     @id @default(uuid())
  tenantId      String?    @map("tenant_id")
  name          Json
  slug          String
  isSystemRole  Boolean    @default(false) @map("is_system_role")
  createdAt     DateTime   @default(now()) @map("created_at")

  company       Company?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles     UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      PermissionAction
  slug        String           @unique
  description Json?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      Json
  address   String?
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]

  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  branchId  String?  @map("branch_id")
  name      Json
  address   String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company       Company    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stockLevels   StockLevel[]
  inventoryDocs InventoryDocument[]
  sourceTransfers StockTransfer[] @relation("SourceWarehouse")
  targetTransfers StockTransfer[] @relation("TargetWarehouse")
  salesInvoices SalesInvoice[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns  PurchaseReturn[]
  salesReturns     SalesReturn[]
  productBatches   ProductBatch[]
  salesOrders      SalesOrder[]
  stockReservations StockReservation[]

  @@index([tenantId])
  @@map("warehouses")
}

// ============================================
// FINANCIAL REFERENCES
// ============================================

model Currency {
  id        String  @id @default(uuid())
  code      String  @unique
  name      Json
  symbol    String
  isDefault Boolean @default(false) @map("is_default")

  @@map("currencies")
}

model TaxRate {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  name      Json
  rate      Decimal  @db.Decimal(5, 2)
  code      String
  isDefault Boolean  @default(false) @map("is_default")

  company   Company? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tax_rates")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  userId     String?     @map("user_id")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  company    Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// MODULE 2: CATEGORIES & PRODUCT NOMENCLATURE
// ============================================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  parentId  String?  @map("parent_id")
  name      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryParent")
  products  Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  categoryId     String?       @map("category_id")
  type           ProductType   @default(PRODUCT)
  name           Json
  description    Json?
  sku            String
  barcode        String?
  unitOfMeasure  UnitOfMeasure @default(piece) @map("unit_of_measure")
  costPrice      Decimal       @default(0) @db.Decimal(15, 2) @map("cost_price")
  salePrice      Decimal       @default(0) @db.Decimal(15, 2) @map("sale_price")
  vatRate        Decimal       @default(12) @db.Decimal(5, 2) @map("vat_rate")
  minStockAlert  Decimal       @default(0) @db.Decimal(15, 2) @map("min_stock_alert")
  weight         Decimal       @default(0) @db.Decimal(15, 3)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company        Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  stockLevels    StockLevel[]
  docItems       InventoryDocumentItem[]
  transferItems  StockTransferItem[]
  asBundleParent ProductBundleItem[]  @relation("BundleParent")
  asBundleChild  ProductBundleItem[]  @relation("BundleChild")
  invoiceItems   SalesInvoiceItem[]
  orderItems     SalesOrderItem[]
  purchaseItems  PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  productBatches       ProductBatch[]
  salesReturnItems     SalesReturnItem[]
  productPrices        ProductPrice[]
  additionalExpenseItems AdditionalExpenseItem[]
  productionOrders       ProductionOrder[]
  stockReservations      StockReservation[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  productId       String   @map("product_id")
  sku             String
  barcode         String?
  name            Json
  priceAdjustment Decimal  @default(0) @db.Decimal(15, 2) @map("price_adjustment")

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("product_variants")
}

model ProductBundleItem {
  id                 String  @id @default(uuid())
  bundleProductId    String  @map("bundle_product_id")
  componentProductId String  @map("component_product_id")
  quantity           Decimal @db.Decimal(15, 3)

  bundleProduct    Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct Product @relation("BundleChild", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@map("product_bundle_items")
}

model StockLevel {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  warehouseId      String   @map("warehouse_id")
  productId        String   @map("product_id")
  quantity         Decimal  @default(0) @db.Decimal(15, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(15, 3) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company          Company   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId])
  @@map("stock_levels")
}

model InventoryDocument {
  id          String             @id @default(uuid())
  tenantId    String             @map("tenant_id")
  warehouseId String             @map("warehouse_id")
  docNumber   String             @map("doc_number")
  docType     InventoryDocType   @map("doc_type")
  docStatus   InventoryDocStatus @default(DRAFT) @map("doc_status")
  docDate     DateTime           @default(now()) @map("doc_date")
  comment     String?
  totalAmount Decimal            @default(0) @db.Decimal(15, 2) @map("total_amount")
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  company     Company                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy   User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       InventoryDocumentItem[]

  @@unique([tenantId, docNumber])
  @@index([tenantId])
  @@map("inventory_documents")
}

model InventoryDocumentItem {
  id         String            @id @default(uuid())
  documentId String            @map("document_id")
  productId  String            @map("product_id")
  quantity   Decimal           @db.Decimal(15, 3)
  unitPrice  Decimal           @db.Decimal(15, 2) @map("unit_price")
  totalPrice Decimal           @db.Decimal(15, 2) @map("total_price")

  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_document_items")
}

model StockTransfer {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  sourceWarehouseId String             @map("source_warehouse_id")
  targetWarehouseId String             @map("target_warehouse_id")
  transferNumber    String             @map("transfer_number")
  status            InventoryDocStatus @default(DRAFT)
  transferDate      DateTime           @default(now()) @map("transfer_date")
  shippedAt         DateTime?          @map("shipped_at")
  receivedAt        DateTime?          @map("received_at")
  comment           String?
  createdById       String?            @map("created_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")

  company         Company             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Cascade)
  targetWarehouse Warehouse           @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Cascade)
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items           StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String        @map("transfer_id")
  productId  String        @map("product_id")
  quantity   Decimal       @db.Decimal(15, 3)

  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

// ============================================
// MODULE 3: COUNTERPARTIES, SALES, PURCHASES, CRM
// ============================================

model Counterparty {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  type        CounterpartyType @default(CUSTOMER)
  name        String
  inn         String?          // STIR (9 digits in Uzbekistan)
  mfo         String?          // MFO (5 digits)
  bankAccount String?          @map("bank_account")
  bankName    String?          @map("bank_name")
  phone       String?
  email       String?
  address         String?
  folderId        String?          @map("folder_id")
  priceListId     String?          @map("price_list_id")
  discountPercent Decimal          @default(0) @db.Decimal(5, 2) @map("discount_percent")
  debtBalance     Decimal          @default(0) @db.Decimal(15, 2) @map("debt_balance")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company             Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder              CounterpartyFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  priceList           PriceList?           @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  purchaseOrders      PurchaseOrder[]
  deals               Deal[]
  payments            Payment[]
  financeTransactions FinanceTransaction[]
  purchaseReceipts    PurchaseReceipt[]
  purchaseReturns     PurchaseReturn[]
  purchaseExpenses    PurchaseExpense[]
  salesReturns        SalesReturn[]
  additionalExpenses  AdditionalExpense[]

  @@index([tenantId])
  @@index([tenantId, folderId])
  @@index([tenantId, inn])
  @@map("counterparties")
}

model CounterpartyFolder {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String?  @default("#3b82f6")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company        Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparties Counterparty[]

  @@index([tenantId])
  @@map("counterparty_folders")
}

model SalesOrder {
  id                      String             @id @default(uuid())
  tenantId                String             @map("tenant_id")
  counterpartyId          String             @map("counterparty_id")
  orderNumber             String             @map("order_number")
  status                  SalesOrderStatus   @default(NEW)
  paymentCondition        PaymentCondition   @default(PREPAID_100) @map("payment_condition")
  requiredPaymentPercent  Decimal?           @db.Decimal(5, 2) @map("required_payment_percent")
  orderDate               DateTime           @default(now()) @map("order_date")
  deliveryDate            DateTime?          @map("delivery_date")
  deliveryAddress         String?            @map("delivery_address")
  currency                String             @default("UZS")
  exchangeRate            Decimal            @default(1) @db.Decimal(15, 4) @map("exchange_rate")
  subtotalAmount          Decimal            @default(0) @db.Decimal(15, 2) @map("subtotal_amount")
  discountAmount          Decimal            @default(0) @db.Decimal(15, 2) @map("discount_amount")
  totalAmount             Decimal            @default(0) @db.Decimal(15, 2) @map("total_amount")
  paidAmount              Decimal            @default(0) @db.Decimal(15, 2) @map("paid_amount")
  comment                 String?
  priceListId             String?            @map("price_list_id")
  warehouseId             String?            @map("warehouse_id")
  assignedSellerId        String?            @map("assigned_seller_id")
  createdById             String?            @map("created_by_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  company        Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty   Counterparty      @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  priceList      PriceList?        @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  assignedSeller User?             @relation("AssignedSalesOrders", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("CreatedSalesOrders", fields: [createdById], references: [id], onDelete: SetNull)
  items          SalesOrderItem[]
  productionOrders ProductionOrder[]
  payments       Payment[]
  salesInvoices  SalesInvoice[]
  reservations   StockReservation[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, counterpartyId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id          String     @id @default(uuid())
  orderId     String     @map("order_id")
  productId   String     @map("product_id")
  quantity    Decimal    @db.Decimal(15, 3)
  unitPrice   Decimal    @db.Decimal(15, 2) @map("unit_price")
  discount    Decimal    @default(0) @db.Decimal(15, 2)
  totalPrice  Decimal    @db.Decimal(15, 2) @map("total_price")
  reservedQty Decimal    @default(0) @db.Decimal(15, 3) @map("reserved_qty")
  readyQty    Decimal    @default(0) @db.Decimal(15, 3) @map("ready_qty")
  shippedQty  Decimal    @default(0) @db.Decimal(15, 3) @map("shipped_qty")

  order            SalesOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productionOrders ProductionOrder[]

  @@map("sales_order_items")
}

model StockReservation {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  orderId     String      @map("order_id")
  productId   String      @map("product_id")
  warehouseId String      @map("warehouse_id")
  quantity    Decimal     @db.Decimal(15, 3)
  createdAt   DateTime    @default(now()) @map("created_at")

  company     Company     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, productId, warehouseId])
  @@index([orderId])
  @@map("stock_reservations")
}

model ProductionOrder {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  salesOrderId   String                @map("sales_order_id")
  salesOrderItemId String?             @map("sales_order_item_id")
  productId      String                @map("product_id")
  requiredQty    Decimal               @db.Decimal(15, 3) @map("required_qty")
  readyQty       Decimal               @default(0) @db.Decimal(15, 3) @map("ready_qty")
  status         ProductionOrderStatus @default(PENDING)
  dueDate        DateTime?             @map("due_date")
  assignedToId   String?               @map("assigned_to_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  company        Company      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignedTo     User?        @relation("AssignedProductionOrders", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, salesOrderId])
  @@map("production_orders")
}

model SalesInvoice {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  warehouseId    String             @map("warehouse_id")
  counterpartyId String             @map("counterparty_id")
  salesOrderId   String?            @map("sales_order_id")
  invoiceNumber  String             @map("invoice_number")
  status         SalesDocStatus     @default(DRAFT)
  paymentStatus  SalesPaymentStatus @default(UNPAID) @map("payment_status")
  returnStatus   SalesReturnStatus  @default(NONE) @map("return_status")
  invoiceDate    DateTime           @default(now()) @map("invoice_date")
  currency       String             @default("UZS")
  exchangeRate   Decimal            @default(1) @db.Decimal(15, 4) @map("exchange_rate")
  contractNumber String?            @map("contract_number")
  contractDate   DateTime?          @map("contract_date")
  paymentTerms   String?            @map("payment_terms")
  comment        String?
  priceListId    String?            @map("price_list_id")
  subtotalAmount Decimal            @default(0) @db.Decimal(15, 2) @map("subtotal_amount")
  discountAmount Decimal            @default(0) @db.Decimal(15, 2) @map("discount_amount")
  vatAmount      Decimal            @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount    Decimal            @default(0) @db.Decimal(15, 2) @map("total_amount")
  paidAmount     Decimal            @default(0) @db.Decimal(15, 2) @map("paid_amount")
  totalCogs      Decimal            @default(0) @db.Decimal(15, 2) @map("total_cogs")
  grossProfit    Decimal            @default(0) @db.Decimal(15, 2) @map("gross_profit")
  createdById    String?            @map("created_by_id")
  postedById     String?            @map("posted_by_id")
  postedAt       DateTime?          @map("posted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  company      Company            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  counterparty Counterparty       @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  priceList    PriceList?         @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("CreatedSalesInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy     User?              @relation("PostedSalesInvoices", fields: [postedById], references: [id], onDelete: SetNull)
  items        SalesInvoiceItem[]
  payments     Payment[]
  returns      SalesReturn[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, counterpartyId])
  @@index([tenantId, status])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id              String       @id @default(uuid())
  invoiceId       String       @map("invoice_id")
  productId       String       @map("product_id")
  quantity        Decimal      @db.Decimal(15, 3)
  unitPrice       Decimal      @db.Decimal(15, 2) @map("unit_price")
  discount        Decimal      @default(0) @db.Decimal(15, 2)
  vatRate         Decimal      @default(0) @db.Decimal(5, 2) @map("vat_rate")
  vatAmount       Decimal      @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalPrice      Decimal      @db.Decimal(15, 2) @map("total_price")
  unitCogs        Decimal      @default(0) @db.Decimal(15, 2) @map("unit_cogs")
  lineCogs        Decimal      @default(0) @db.Decimal(15, 2) @map("line_cogs")
  lineGrossProfit Decimal      @default(0) @db.Decimal(15, 2) @map("line_gross_profit")
  isBelowCost     Boolean      @default(false) @map("is_below_cost")

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchConsumptions BatchConsumption[]

  @@map("sales_invoice_items")
}

model SalesReturn {
  id             String               @id @default(uuid())
  tenantId       String               @map("tenant_id")
  returnNumber   String               @map("return_number")
  returnDate     DateTime             @default(now()) @map("return_date")
  invoiceId      String?              @map("invoice_id")
  counterpartyId String               @map("counterparty_id")
  warehouseId    String               @map("warehouse_id")
  currency       String               @default("UZS")
  reason         String?
  status         SalesReturnDocStatus @default(POSTED)
  totalAmount    Decimal              @default(0) @db.Decimal(15, 2) @map("total_amount")
  totalCogs      Decimal              @default(0) @db.Decimal(15, 2) @map("total_cogs")
  createdById    String?              @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  company      Company           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty Counterparty      @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  invoice      SalesInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("CreatedSalesReturns", fields: [createdById], references: [id], onDelete: SetNull)
  items        SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id         String      @id @default(uuid())
  returnId   String      @map("return_id")
  productId  String      @map("product_id")
  quantity   Decimal     @db.Decimal(15, 3)
  unitPrice  Decimal     @db.Decimal(15, 2) @map("unit_price")
  totalPrice Decimal     @db.Decimal(15, 2) @map("total_price")
  unitCogs   Decimal     @default(0) @db.Decimal(15, 2) @map("unit_cogs")
  lineCogs   Decimal     @default(0) @db.Decimal(15, 2) @map("line_cogs")

  return  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sales_return_items")
}

model PriceList {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  name           Json
  currency       String         @default("UZS")
  isDefault      Boolean        @default(false) @map("is_default")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company        Company        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices         ProductPrice[]
  counterparties Counterparty[]
  salesOrders    SalesOrder[]
  salesInvoices  SalesInvoice[]

  @@index([tenantId])
  @@map("price_lists")
}

model ProductPrice {
  id          String   @id @default(uuid())
  priceListId String   @map("price_list_id")
  productId   String   @map("product_id")
  price       Decimal  @db.Decimal(15, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("product_prices")
}

model PurchaseOrder {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  counterpartyId String            @map("counterparty_id")
  orderNumber    String            @map("order_number")
  status         InventoryDocStatus @default(DRAFT)
  orderDate      DateTime          @default(now()) @map("order_date")
  totalAmount    Decimal           @default(0) @db.Decimal(15, 2) @map("total_amount")
  createdAt      DateTime          @default(now()) @map("created_at")

  company      Company             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty Counterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  items        PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  orderId    String        @map("order_id")
  productId  String        @map("product_id")
  quantity   Decimal       @db.Decimal(15, 3)
  unitPrice  Decimal       @db.Decimal(15, 2) @map("unit_price")
  totalPrice Decimal       @db.Decimal(15, 2) @map("total_price")

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Deal {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  counterpartyId String        @map("counterparty_id")
  title          String
  stage          DealStageSlug @default(LEAD)
  amount         Decimal       @default(0) @db.Decimal(15, 2)
  assignedUserId String?       @map("assigned_user_id")
  expectedClose  DateTime?     @map("expected_close")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company      Company      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("deals")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  counterpartyId String        @map("counterparty_id")
  invoiceId      String?       @map("invoice_id")
  orderId        String?       @map("order_id")
  cashAccountId  String?       @map("cash_account_id")
  paymentNumber  String        @map("payment_number")
  method         PaymentMethod @default(BANK_TRANSFER)
  amount         Decimal       @db.Decimal(15, 2)
  paymentDate    DateTime      @default(now()) @map("payment_date")
  comment        String?
  createdAt      DateTime      @default(now()) @map("created_at")

  company      Company       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty Counterparty  @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  invoice      SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, paymentNumber])
  @@index([tenantId])
  @@map("payments")
}

// ============================================
// MODULE 4: GENERAL LEDGER & UZBEK ACCOUNTING (BHMS/NAS)
// ============================================

model Account {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  code      String      // NAS account code (e.g. "2910", "2920", "4010", "5110", "6410", "9010", "9110")
  name      Json        // Bilingual name { "uz": "...", "ru": "..." }
  type      AccountType
  isSystem  Boolean     @default(false) @map("is_system")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  company     Company       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  entryNumber   String   @map("entry_number")
  entryDate     DateTime @default(now()) @map("entry_date")
  description   String
  sourceDocType String?  @map("source_doc_type") // "SalesInvoice", "Payment", "InventoryDocument", "StockTransfer", etc.
  sourceDocId   String?  @map("source_doc_id")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  entryId        String       @map("entry_id")
  debitAccountId String       @map("debit_account_id")
  creditAccountId String      @map("credit_account_id")
  amount         Decimal      @db.Decimal(15, 2)
  description    String?

  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccount  Account      @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Cascade)
  creditAccount Account      @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@map("journal_lines")
}

// ============================================
// MODULE 5: FINANCE — CASH FLOW MANAGEMENT
// ============================================

model CashAccount {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  accountType CashAccountType @map("account_type")
  name        Json            // { "uz": "...", "ru": "..." }
  currency    String          @default("UZS") // "UZS" or "USD"
  balance     Decimal         @default(0) @db.Decimal(15, 2)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company            Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       FinanceTransaction[] @relation("TxAccount")
  transfersTo        FinanceTransaction[] @relation("TxTransferTo")
  additionalExpenses AdditionalExpense[]
  payments           Payment[]

  @@unique([tenantId, accountType])
  @@index([tenantId])
  @@map("cash_accounts")
}

model TransactionType {
  id        String              @id @default(uuid())
  tenantId  String?             @map("tenant_id")
  direction TransactionDirection
  name      Json                // { "uz": "...", "ru": "..." }
  isSystem  Boolean             @default(false) @map("is_system")

  company      Company?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@index([tenantId])
  @@map("transaction_types")
}

model FinanceTransaction {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  direction         TransactionDirection
  /// For INCOME: the account that received the money
  /// For EXPENSE: the account that money left from
  /// For TRANSFER: the source account
  accountId         String?             @map("account_id")
  /// For TRANSFER only: the destination account
  transferToId      String?             @map("transfer_to_id")
  counterpartyId    String?             @map("counterparty_id")
  transactionTypeId String?             @map("transaction_type_id")
  amount            Decimal             @db.Decimal(15, 2)
  currency          String              @default("UZS")
  transactionDate   DateTime            @default(now()) @map("transaction_date")
  comment           String?
  docNumber         String?             @map("doc_number")
  sourceDocType     String?             @map("source_doc_type")
  sourceDocId       String?             @map("source_doc_id")
  createdById       String?             @map("created_by_id")
  isDeleted         Boolean             @default(false) @map("is_deleted")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  company           Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           CashAccount?     @relation("TxAccount", fields: [accountId], references: [id], onDelete: SetNull)
  transferToAccount CashAccount?     @relation("TxTransferTo", fields: [transferToId], references: [id], onDelete: SetNull)
  counterparty      Counterparty?    @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  transactionType   TransactionType? @relation(fields: [transactionTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, direction])
  @@index([tenantId, transactionDate])
  @@map("finance_transactions")
}

// ============================================
// MODULE 9: PURCHASES & LANDED COST MANAGEMENT
// ============================================

model PurchaseReceipt {
  id                      String            @id @default(uuid())
  tenantId                String            @map("tenant_id")
  docNumber               String            @map("doc_number")
  docDate                 DateTime          @default(now()) @map("doc_date")
  counterpartyId          String            @map("counterparty_id")
  warehouseId             String            @map("warehouse_id")
  currency                String            @default("UZS")
  exchangeRate            Decimal           @default(1) @db.Decimal(15, 4) @map("exchange_rate")
  contractNumber          String?           @map("contract_number")
  contractDate            DateTime?         @map("contract_date")
  comment                 String?
  status                  PurchaseDocStatus     @default(DRAFT)
  paymentStatus           PurchasePaymentStatus @default(UNPAID) @map("payment_status")
  returnStatus            PurchaseReturnStatus  @default(NONE) @map("return_status")
  subtotalAmount          Decimal               @default(0) @db.Decimal(15, 2) @map("subtotal_amount")
  discountAmount          Decimal           @default(0) @db.Decimal(15, 2) @map("discount_amount")
  vatAmount               Decimal           @default(0) @db.Decimal(15, 2) @map("vat_amount")
  additionalExpensesTotal Decimal           @default(0) @db.Decimal(15, 2) @map("additional_expenses_total")
  totalAmount             Decimal           @default(0) @db.Decimal(15, 2) @map("total_amount")
  paidAmount              Decimal           @default(0) @db.Decimal(15, 2) @map("paid_amount")

  // GTD / Import fields
  gtdNumber               String?           @map("gtd_number")
  gtdDate                 DateTime?         @map("gtd_date")
  customsPost             String?           @map("customs_post")

  createdById             String?           @map("created_by_id")
  postedById              String?           @map("posted_by_id")
  postedAt                DateTime?         @map("posted_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  company                 Company                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty            Counterparty           @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  warehouse               Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy               User?                  @relation("CreatedPurchaseReceipts", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy                User?                  @relation("PostedPurchaseReceipts", fields: [postedById], references: [id], onDelete: SetNull)
  items                   PurchaseReceiptItem[]
  expenses                PurchaseExpense[]
  returns                 PurchaseReturn[]
  batches                 ProductBatch[]
  additionalExpenses      AdditionalExpense[]

  @@unique([tenantId, docNumber])
  @@index([tenantId])
  @@index([tenantId, counterpartyId])
  @@index([tenantId, status])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String          @id @default(uuid())
  receiptId         String          @map("receipt_id")
  productId         String          @map("product_id")
  quantity          Decimal         @db.Decimal(15, 3)
  returnedQuantity  Decimal         @default(0) @db.Decimal(15, 3) @map("returned_quantity")
  weight            Decimal         @default(0) @db.Decimal(15, 3)
  unitPrice         Decimal         @db.Decimal(15, 2) @map("unit_price")
  discount          Decimal         @default(0) @db.Decimal(15, 2)
  vatRate           Decimal         @default(0) @db.Decimal(5, 2) @map("vat_rate")
  vatAmount         Decimal         @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalPrice        Decimal         @db.Decimal(15, 2) @map("total_price")
  allocatedExpenses Decimal         @default(0) @db.Decimal(15, 2) @map("allocated_expenses")
  landedCost        Decimal         @default(0) @db.Decimal(15, 2) @map("landed_cost")

  receipt           PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  additionalExpenseItems AdditionalExpenseItem[]

  @@map("purchase_receipt_items")
}

model PurchaseExpense {
  id               String                  @id @default(uuid())
  tenantId         String                  @map("tenant_id")
  receiptId        String                  @map("receipt_id")
  expenseType      ExpenseType             @map("expense_type")
  supplierId       String?                 @map("supplier_id")
  amount           Decimal                 @db.Decimal(15, 2)
  currency         String                  @default("UZS")
  allocationMethod ExpenseAllocationMethod @default(BY_AMOUNT) @map("allocation_method")
  comment          String?
  createdAt        DateTime                @default(now()) @map("created_at")

  company          Company                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt          PurchaseReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  supplier         Counterparty?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("purchase_expenses")
}

model PurchaseReturn {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  returnNumber   String          @map("return_number")
  returnDate     DateTime        @default(now()) @map("return_date")
  receiptId      String?         @map("receipt_id")
  counterpartyId String          @map("counterparty_id")
  warehouseId    String          @map("warehouse_id")
  currency       String          @default("UZS")
  reason         String?
  status         ReturnDocStatus @default(DRAFT)
  totalAmount    Decimal         @default(0) @db.Decimal(15, 2) @map("total_amount")
  createdById    String?         @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company        Company              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt        PurchaseReceipt?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  counterparty   Counterparty         @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("CreatedPurchaseReturns", fields: [createdById], references: [id], onDelete: SetNull)
  items          PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id         String         @id @default(uuid())
  returnId   String         @map("return_id")
  productId  String         @map("product_id")
  quantity   Decimal        @db.Decimal(15, 3)
  unitPrice  Decimal        @db.Decimal(15, 2) @map("unit_price")
  totalPrice Decimal        @db.Decimal(15, 2) @map("total_price")

  return     PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchase_return_items")
}

model ProductBatch {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  productId     String           @map("product_id")
  warehouseId   String           @map("warehouse_id")
  receiptId     String?          @map("receipt_id")
  batchNumber   String           @map("batch_number")
  initialQty    Decimal          @db.Decimal(15, 3) @map("initial_qty")
  remainingQty  Decimal          @db.Decimal(15, 3) @map("remaining_qty")
  purchasePrice Decimal          @db.Decimal(15, 2) @map("purchase_price")
  landedCost    Decimal          @db.Decimal(15, 2) @map("landed_cost")
  createdAt     DateTime         @default(now()) @map("created_at")

  company       Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  receipt       PurchaseReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  consumptions  BatchConsumption[]

  @@index([tenantId])
  @@index([tenantId, warehouseId, productId])
  @@map("product_batches")
}

// ============================================
// MODULE 10: STANDALONE ADDITIONAL EXPENSES & LANDED COST
// ============================================

model AdditionalExpense {
  id               String                  @id @default(uuid())
  tenantId         String                  @map("tenant_id")
  docNumber        String                  @map("doc_number")
  docDate          DateTime                @default(now()) @map("doc_date")
  status           PurchaseDocStatus       @default(DRAFT)
  expenseType      ExpenseType             @map("expense_type")
  counterpartyId   String                  @map("counterparty_id")
  receiptId        String                  @map("receipt_id")
  amount           Decimal                 @db.Decimal(15, 2)
  currency         String                  @default("UZS")
  exchangeRate     Decimal                 @default(1) @db.Decimal(15, 4) @map("exchange_rate")
  vatRate          Decimal                 @default(0) @db.Decimal(5, 2) @map("vat_rate")
  vatAmount        Decimal                 @default(0) @db.Decimal(15, 2) @map("vat_amount")
  allocationMethod ExpenseAllocationMethod @default(BY_AMOUNT) @map("allocation_method")
  isPaid           Boolean                 @default(false) @map("is_paid")
  cashAccountId    String?                 @map("cash_account_id")
  comment          String?
  createdById      String?                 @map("created_by_id")
  postedById       String?                 @map("posted_by_id")
  postedAt         DateTime?               @map("posted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  company          Company                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  counterparty     Counterparty            @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  receipt          PurchaseReceipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  cashAccount      CashAccount?            @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  createdBy        User?                   @relation("CreatedAdditionalExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy         User?                   @relation("PostedAdditionalExpenses", fields: [postedById], references: [id], onDelete: SetNull)
  items            AdditionalExpenseItem[]

  @@unique([tenantId, docNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([receiptId])
  @@map("additional_expenses")
}

model AdditionalExpenseItem {
  id                String            @id @default(uuid())
  expenseId         String            @map("expense_id")
  receiptItemId     String            @map("receipt_item_id")
  productId         String            @map("product_id")
  initialLandedCost Decimal           @default(0) @db.Decimal(15, 2) @map("initial_landed_cost")
  allocatedAmount   Decimal           @default(0) @db.Decimal(15, 2) @map("allocated_amount")
  newLandedCost     Decimal           @default(0) @db.Decimal(15, 2) @map("new_landed_cost")
  soldQuantity      Decimal           @default(0) @db.Decimal(15, 3) @map("sold_quantity")
  remainingQuantity Decimal           @default(0) @db.Decimal(15, 3) @map("remaining_quantity")
  cogsAdjustment    Decimal           @default(0) @db.Decimal(15, 2) @map("cogs_adjustment")

  expense           AdditionalExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  receiptItem       PurchaseReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("additional_expense_items")
}

model BatchConsumption {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  salesInvoiceItemId String           @map("sales_invoice_item_id")
  batchId            String           @map("batch_id")
  quantity           Decimal          @db.Decimal(15, 3)
  unitCost           Decimal          @db.Decimal(15, 2) @map("unit_cost")
  createdAt          DateTime         @default(now()) @map("created_at")

  company            Company          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)
  batch              ProductBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId])
  @@index([salesInvoiceItemId])
  @@map("batch_consumptions")
}
