
# Billing providers. Leave a provider's values empty to disable it: its
# checkout is refused and its callbacks are rejected.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
00

# Database (PostgreSQL)
DATABASE_URL=postgresql://sklad_user:sklad_password@localhost:5432/sklad_dev?schema=public
# Disposable database used only by `npm run test:integration` (must differ from DATABASE_URL)
DATABASE_URL_TEST=postgresql://sklad_user:sklad_password@localhost:5432/sklad_test?schema=public
POSTGRES_USER=sklad_user
POSTGRES_PASSWORD=sklad_password
POSTGRES_DB=sklad_dev
POSTGRES_PORT=5432

# Redis
# Rate-limit counters (D5). Set: counters live in Redis, shared by all API
# instances and kept across restarts. Unset: in process memory (a warning is
# logged at startup in production). Required before running >1 instance.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# i18n
DEFAULT_LANGUAGE=uz
SUPPORTED_LANGUAGES=uz,ru

# App
APP_NAME=Sklad Platform
# Reverse proxies in front of the API (hop count, e.g. 1, or proxy addresses).
# Needed so rate limits see the client IP, not the proxy's. Leave empty locally.
TRUST_PROXY=
TRIAL_PERIOD_DAYS=14
